GOOGLE_MAPS_API_KEY=

DATABASE_URL="mongodb://root:root@db:27017/nest?authSource=admin&directConnection=true"
# Segredo exclusivo para chamadas HTTP internas; gerar 32+ bytes aleatórios, nunca commitar o valor.
ROUTES_INTERNAL_API_TOKEN=
# Chave de capabilities temporárias de uma rota (WS/read/simulate), distinta do token HTTP interno.
ROUTES_WS_TOKEN_SECRET=
# Origens WS explícitas separadas por vírgula (vazio = negar browser cross-origin).
ROUTES_WS_ALLOWED_ORIGINS=
